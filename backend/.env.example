# Copy to backend/.env for local development. Never commit the real .env.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# JSON logs (true) or human-readable (false)
LOG_JSON=false

# PostgreSQL connection. Standard postgres:// / postgresql:// URLs are accepted; on Render,
# use the database's Internal Database URL. The role MUST NOT be a superuser or have
# BYPASSRLS, otherwise row-level tenant isolation is bypassed.
DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_dev
# Used only by the test suite (tests truncate all tables in this database!)
TEST_DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_test

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_MAX_AGE_DAYS=30

# Local http development needs COOKIE_SECURE=false. Always true in production.
COOKIE_SECURE=false
# strict when the frontend is served from the same site as the API (recommended, incl. the
# Render static-site /api rewrite); "none" only if the browser talks cross-site to the API.
COOKIE_SAMESITE=strict

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- Providers (mock = offline, deterministic, clearly labelled; see docs/AI.md) ----
AI_PROVIDER=mock                 # mock | anthropic
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MODEL_REALTIME=claude-opus-5
AI_DAILY_TOKEN_BUDGET=2000000    # per company per 24h; 0 disables
COPILOT_MAX_LLM_CALLS_PER_CALL=30
EMBEDDING_PROVIDER=hashing       # hashing (dev, lexical) | voyage
# VOYAGE_API_KEY=
CALENDAR_PROVIDER=mock           # mock | google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
TELEPHONY_PROVIDER=mock          # only mock is implemented (see docs/TELEPHONY.md)
STT_PROVIDER=mock
# Required in production (>= 32 chars each):
# TELEPHONY_WEBHOOK_SECRET=
# TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
SIMULATION_ENABLED=true
SIMULATION_UTTERANCE_DELAY_SECONDS=2
KNOWLEDGE_MIN_SCORE=0.3
JOBS_WORKER_ENABLED=true
# Rate-limit client IP (see docs/SECURITY.md); 0 ignores X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
DIAGNOSTICS_ENABLED=false
