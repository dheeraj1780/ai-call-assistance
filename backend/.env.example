# Copy to backend/.env for local development. Never commit the real .env.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# JSON logs (true) or human-readable (false)
LOG_JSON=false

# PostgreSQL connection. Standard postgres:// / postgresql:// URLs are accepted; on Render,
# use the database's Internal Database URL. The role MUST NOT be a superuser or have
# BYPASSRLS, otherwise row-level tenant isolation is bypassed.
DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_dev
# Used only by the test suite (tests truncate all tables in this database!)
TEST_DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_test

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_MAX_AGE_DAYS=30

# Local http development needs COOKIE_SECURE=false. Always true in production.
COOKIE_SECURE=false
# strict when the frontend is served from the same site as the API (recommended, incl. the
# Render static-site /api rewrite); "none" only if the browser talks cross-site to the API.
COOKIE_SAMESITE=strict

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- Future phases (not used yet; listed so nobody commits them to source) ----
# ANTHROPIC_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# TELEPHONY_PROVIDER_API_KEY=
# TELEPHONY_PROVIDER_API_SECRET=
