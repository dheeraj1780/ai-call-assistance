# Copy to backend/.env for local development. Never commit the real .env.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# JSON logs (true) or human-readable (false)
LOG_JSON=false

# PostgreSQL connection. Standard postgres:// / postgresql:// URLs are accepted; on Render,
# use the database's Internal Database URL. The role MUST NOT be a superuser or have
# BYPASSRLS, otherwise row-level tenant isolation is bypassed.
DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_dev
# Used only by the test suite (tests truncate all tables in this database!)
TEST_DATABASE_URL=postgresql://callcopilot:CHANGE_ME@127.0.0.1:5432/callcopilot_test

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_MAX_AGE_DAYS=30

# Local http development needs COOKIE_SECURE=false. Always true in production.
COOKIE_SECURE=false
# strict when the frontend is served from the same site as the API (recommended, incl. the
# Render static-site /api rewrite); "none" only if the browser talks cross-site to the API.
COOKIE_SAMESITE=strict

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- Providers (mock = offline, deterministic, clearly labelled; see docs/AI.md) ----
AI_PROVIDER=mock                 # mock | anthropic | gemini  (all AI tasks)
# Reply suggestions for WhatsApp/Teams conversations only: inherit | mock | anthropic | gemini
# AI_MESSAGE_ASSIST_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                   # Google AI Studio key (Gemini Developer API)
# GEMINI_MODEL=gemini-3.8-flash      # or gemini-3.5-flash-lite (faster, cheaper)
# GEMINI_THINKING_LEVEL=low          # low | medium | high | (empty = model default)
AI_MODEL=claude-opus-5
AI_MODEL_REALTIME=claude-opus-5
AI_DAILY_TOKEN_BUDGET=2000000    # per company per 24h; 0 disables
COPILOT_MAX_LLM_CALLS_PER_CALL=30
EMBEDDING_PROVIDER=hashing       # hashing (dev, lexical) | voyage | gemini (uses GEMINI_API_KEY)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# KNOWLEDGE_TOP_K=3                  # excerpts retrieved per question
# KNOWLEDGE_MIN_SCORE=               # similarity threshold override (gemini default 0.60)
# VOYAGE_API_KEY=
CALENDAR_PROVIDER=mock           # mock | google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Fallback for PHONE calls when a company has no enabled Plivo integration: mock | none
TELEPHONY_PROVIDER=mock
# Speech-to-text: mock (offline) | google (Cloud Speech-to-Text v2, docs/integrations/google-stt.md)
STT_PROVIDER=mock

# Google Meet (Meet REST API + Meet Media API - Developer Preview). A separate OAuth *Web
# application* client; register GOOGLE_MEET_REDIRECT_URI on it. See GOOGLE-MEET-CREDENTIALS-REQUIRED.md.
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=
# GOOGLE_MEET_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-meet/oauth/callback
# STT_LANGUAGE=en-IN                 # default call language: en-IN | en-US | hi-IN | de-DE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=    # path to a service-account JSON OUTSIDE the repository
# GOOGLE_STT_LOCATION=us             # chirp_3 streaming: us | eu
# GOOGLE_STT_MODEL=chirp_3
# STT_CHUNK_MS=250  STT_AUDIO_QUEUE_CHUNKS=120  STT_STREAM_MAX_SECONDS=280
# STT_CONNECT_TIMEOUT_SECONDS=10  STT_MAX_RECONNECTS=3
# Required in production (>= 32 chars each):
# TELEPHONY_WEBHOOK_SECRET=
# TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
SIMULATION_ENABLED=true
SIMULATION_UTTERANCE_DELAY_SECONDS=2
# KNOWLEDGE_MIN_SCORE=  # default: 0.10 for hashing, 0.30 for voyage
JOBS_WORKER_ENABLED=true
# Rate-limit client IP (see docs/SECURITY.md); 0 ignores X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
DIAGNOSTICS_ENABLED=false

# ---- Communication integrations (docs/integrations/credentials.md) ----------------------
# WhatsApp and Plivo credentials are entered per company in Settings > Integrations (stored
# encrypted with TOKEN_ENCRYPTION_KEY) - not here. Live webhooks need PUBLIC_BASE_URL=https://...
# Platform Microsoft Entra app for Teams messaging (companies may use their own instead):
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Teams real-time media gateway (teams-media-gateway/, Windows Server in Azure):
# TEAMS_MEDIA_GATEWAY_URL=https://media.example.com:9441
# TEAMS_MEDIA_GATEWAY_SECRET=          # >= 32 chars, same as the gateway's BackendSharedSecret
# WHATSAPP_GRAPH_API_VERSION=v23.0
# DEFAULT_PHONE_COUNTRY_CODE=91       # for matching local 10-digit numbers
# CONVERSATION_AI_ASSIST_ENABLED=true
