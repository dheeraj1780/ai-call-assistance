# Leave empty to call the API on the same origin (/api/...). This is the recommended setup:
# Vite proxies /api in development and a Render static-site rewrite proxies it in production,
# which keeps the refresh cookie first-party.
VITE_API_BASE_URL=
# Optional: WebSocket base (e.g. wss://callcopilot-api.onrender.com) when the static host
# cannot proxy WebSockets to the API. Empty = same origin.
VITE_WS_BASE_URL=
