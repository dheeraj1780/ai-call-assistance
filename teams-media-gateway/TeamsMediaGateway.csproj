<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Teams real-time media gateway for CallCopilot.
    STATUS: SOURCE ONLY - NOT BUILT, NOT RUN. No .NET SDK was available where this was written.
    Microsoft's application-hosted media library runs only on Windows (x64) and must be kept
    current (Microsoft requires a Microsoft.Graph.Communications.Calls.Media version that is the
    newest or not older than ~3 months). Pin exact versions when you first build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CallCopilot.TeamsMediaGateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating versions on purpose until the first real build pins them (see README). -->
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" Version="1.*" />
    <PackageReference Include="Microsoft.Graph.Communications.Calls" Version="1.*" />
    <PackageReference Include="Microsoft.Graph.Communications.Client" Version="1.*" />
    <PackageReference Include="Microsoft.Graph.Communications.Common" Version="1.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
  </ItemGroup>
</Project>
