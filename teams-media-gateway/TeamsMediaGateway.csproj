<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Teams real-time media gateway for CallCopilot.
    STATUS: builds with the .NET 8 SDK (see README). Real Teams media has not been exercised.
    Microsoft's application-hosted media library runs only on Windows (x64) and must be kept
    current (Microsoft requires a Microsoft.Graph.Communications.Calls.Media version that is the
    newest or not older than ~3 months). Pin exact versions when you first build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CallCopilot.TeamsMediaGateway</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- Separate dev-PC tools (own projects), never part of the gateway build or package. -->
    <Compile Remove="tools/**" />
    <Content Remove="tools/**" />
    <None Remove="tools/**" />
    <InternalsVisibleTo Include="TeamsMediaGateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pinned to 1.2.0.17950 (published 2026-07-02). Microsoft requires a media library that is the
      newest or not older than ~3 months, so this must be upgraded by ~2026-10. The newer
      1.2.0.18725 (2026-09-03) cannot be restored from nuget.org: it depends on
      Bond.Core.NET, Microsoft.Identity.ServerAuthorization and Microsoft.Skype.Bots.Media.Library,
      which are not published there (checked 2026-09-25).
    -->
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" Version="1.2.0.17950" />
    <PackageReference Include="Microsoft.Graph.Communications.Calls" Version="1.2.0.17950" />
    <!--
      Direct reference (same version Calls.Media 1.2.0.17950 depends on). Its native media libraries
      (NativeMedia.dll, RtmPal.dll, skypert.dll, ...) are copied only by the package's build/*.targets,
      and NuGet does not import build/ targets of transitive dependencies: without this line the
      published gateway has none of them and MediaPlatform.Initialize fails to load 'NativeMedia'.
      The native libraries also need the Visual C++ x64 runtime on the host (package readme).
    -->
    <PackageReference Include="Microsoft.Skype.Bots.Media" Version="1.33.0.258-preview" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
    <!-- Lets the same executable run as a Windows service (deploy-azure-vm.ps1). A no-op when
         started from a console or tests. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
