<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 1 (dev PC): generates the gateway shared secret, stores it as TEAMS_MEDIA_GATEWAY_SECRET in the
    git-ignored backend/.env and hands it to the VM once through the clipboard. Compiled so the secret
    never exists inside a PowerShell process (ScriptBlockLogging/transcription/module logging cannot see
    it). No NuGet packages: only the .NET 8 + Windows Desktop shared frameworks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>CallCopilot.GatewaySecretHandoff</RootNamespace>
    <!-- No generated debug symbols with source paths beyond the default; no telemetry/logging packages. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GatewaySecretHandoff.Tests" />
  </ItemGroup>
</Project>
